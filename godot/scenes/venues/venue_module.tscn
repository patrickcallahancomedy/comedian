stretch_mode = 5

[node name="DetailsLabel" type="Label" parent="Background/Layout"]
layout_mode = 2
text = "SET: 5 MIN    PAY: $0"
horizontal_alignment = 1

[node name="ArrivalText" type="Label" parent="Background/Layout"]
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
