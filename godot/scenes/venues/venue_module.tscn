expected_pay = 0
stage_route_id = "placeholder"
leave_route_id = "calendar"

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.075, 0.09, 1)

[node name="Layout" type="VBoxContainer" parent="Background"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 36.0
offset_top = 70.0
offset_right = -36.0
offset_bottom = -70.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="HeaderLabel" type="Label" parent="Background/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "VENUE"
horizontal_alignment = 1

[node name="VenueNameLabel" type="Label" parent="Background/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "LOCAL VENUE"
