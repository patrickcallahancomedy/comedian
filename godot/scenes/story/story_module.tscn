module_id = "story_module"
next_route_id = "placeholder"
story_title = "STORY PLACEHOLDER"
pages = Array[String](["Replace this text in the Inspector.", "Replace the visual children with real storybook art when ready."])

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.11, 0.1, 0.09, 1)

[node name="Artwork" type="TextureRect" parent="Background"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 32.0
offset_top = 40.0
offset_right = -32.0
offset_bottom = 330.0
grow_horizontal = 2
expand_mode = 1
stretch_mode = 5

[node name="Layout" type="VBoxContainer" parent="Background"]
layout_mode = 1
anchors_preset = 12
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 32.0
offset_top = -390.0
offset_right = -32.0
offset_bottom = -48.0
grow_horizontal = 2
grow_vertical = 0
theme_override_constants/separation = 20

[node name="TitleLabel" type="Label" parent="Background/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
