[sub_resource type="Shader" id="Shader_window_glow"]
code = "shader_type canvas_item;\n\nuniform vec4 glow_color : source_color = vec4(1.0, 0.73, 0.34, 0.34);\nuniform float intensity : hint_range(0.0, 1.5) = 0.0;\n\nvoid fragment() {\n\tvec2 d = abs(UV - vec2(0.5)) * 2.0;\n\tfloat edge = max(d.x, d.y);\n\tfloat falloff = 1.0 - smoothstep(0.30, 1.0, edge);\n\tfloat alpha = glow_color.a * mix(0.42, 1.0, falloff) * intensity;\n\tCOLOR = vec4(glow_color.rgb, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_window_glow"]
shader = SubResource("Shader_window_glow")
shader_parameter/glow_color = Color(1, 0.73, 0.34, 0.34)
shader_parameter/intensity = 0.0

[sub_resource type="Shader" id="Shader_troy_silhouette"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.10, 0.09, 0.08, 1.0);\nuniform float white_cutoff : hint_range(0.75, 1.0) = 0.94;\nuniform float silhouette_mix : hint_range(0.0, 1.0) = 1.0;\nuniform float tint_mix : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n\tvec4 sample_color = texture(TEXTURE, UV);\n\tfloat white_value = min(sample_color.r, min(sample_color.g, sample_color.b));\n\tfloat keep_pixel = 1.0 - step(white_cutoff, white_value);\n\tvec3 tinted_color = mix(sample_color.rgb, tint.rgb, tint_mix);\n\tvec3 final_color = mix(tinted_color, tint.rgb, silhouette_mix);\n\tCOLOR = vec4(final_color, sample_color.a * keep_pixel);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_troy"]
shader = SubResource("Shader_troy_silhouette")
shader_parameter/tint = Color(0.1, 0.09, 0.08, 1)
shader_parameter/white_cutoff = 0.94
shader_parameter/silhouette_mix = 1.0
shader_parameter/tint_mix = 0.0

