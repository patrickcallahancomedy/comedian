[sub_resource type="Shader" id="Shader_window_glow"]
code = "shader_type canvas_item;

uniform vec4 glow_color : source_color = vec4(1.0, 0.73, 0.34, 0.34);
uniform float intensity : hint_range(0.0, 1.5) = 0.0;

void fragment() {
	vec2 d = abs(UV - vec2(0.5)) * 2.0;
	float edge = max(d.x, d.y);
	float falloff = 1.0 - smoothstep(0.30, 1.0, edge);
	float alpha = glow_color.a * mix(0.42, 1.0, falloff) * intensity;
	COLOR = vec4(glow_color.rgb, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_window_glow"]
shader = SubResource("Shader_window_glow")
shader_parameter/glow_color = Color(1, 0.73, 0.34, 0.34)
shader_parameter/intensity = 0.0

[sub_resource type="Shader" id="Shader_troy_silhouette"]
code = "shader_type canvas_item;

uniform vec4 tint : source_color = vec4(0.10, 0.09, 0.08, 1.0);
uniform float white_cutoff : hint_range(0.75, 1.0) = 0.94;
uniform float silhouette_mix : hint_range(0.0, 1.0) = 1.0;
uniform float tint_mix : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 sample_color = texture(TEXTURE, UV);
	float white_value = min(sample_color.r, min(sample_color.g, sample_color.b));
	float keep_pixel = 1.0 - step(white_cutoff, white_value);
	vec3 tinted_color = mix(sample_color.rgb, tint.rgb, tint_mix);
	vec3 final_color = mix(tinted_color, tint.rgb, silhouette_mix);
	COLOR = vec4(final_color, sample_color.a * keep_pixel);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_troy"]
shader = SubResource("Shader_troy_silhouette")
shader_parameter/tint = Color(0.1, 0.09, 0.08, 1)
shader_parameter/white_cutoff = 0.94
shader_parameter/silhouette_mix = 1.0
