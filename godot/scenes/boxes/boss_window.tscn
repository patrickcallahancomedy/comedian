[sub_resource type="Shader" id="Shader_troy_silhouette"]
code = "shader_type canvas_item;\n\nuniform vec4 tint : source_color = vec4(0.10, 0.09, 0.08, 0.95);\nuniform float white_cutoff : hint_range(0.75, 1.0) = 0.94;\n\nvoid fragment() {\n\tvec4 sample_color = texture(TEXTURE, UV);\n\tfloat white_value = min(sample_color.r, min(sample_color.g, sample_color.b));\n\tfloat keep_pixel = 1.0 - step(white_cutoff, white_value);\n\tfloat alpha = sample_color.a * keep_pixel * tint.a;\n\tCOLOR = vec4(tint.rgb, alpha);\n}\n"

